# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (local dev, default):
DATABASE_URL=sqlite:///./batjetkiret.db

# PostgreSQL (production — uncomment and fill in):
# DATABASE_URL=postgresql://user:password@localhost:5432/batjetkiret

# ─── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a long random string in production!
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=local-dev-secret-key-change-me

# ─── App ──────────────────────────────────────────────────────────────────────
# Local dev: True.  Production: set DEBUG=release (or False) — app refuses to
# start in prod while SECRET_KEY is still the default value.
DEBUG=True
ALLOW_ORDER_WITHOUT_BALANCE=False
# JWT lifetime in days (issued access tokens).
ACCESS_TOKEN_EXPIRE_DAYS=365

# Public base URL (used for building screenshot URLs etc.)
BASE_URL=http://localhost:8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list. In production set to your real domains.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174,http://localhost:5175

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=False
SERVICE_NAME=batketkiret-backend

# ─── Rate limiting / scaling ────────────────────────────────────────────────────
# Shared rate-limit storage across gunicorn workers. Empty = in-memory (per
# worker). Set to a Redis URL in production when running >1 worker.
REDIS_URL=
# Gunicorn worker count (read by Procfile/Dockerfile). Needs REDIS_URL if >1.
WEB_CONCURRENCY=2

# ─── Error tracking ─────────────────────────────────────────────────────────────
# Leave empty to disable Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ─── Cloudflare R2 (screenshot/media storage) ───────────────────────────────────
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BASE=

# ─── Commission ─────────────────────────────────────────────────────────────────
USER_COMMISSION_PERCENT=10.0
COURIER_COMMISSION_PERCENT=5.0

# ─── Web Push (VAPID, enterprise panel) ─────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@batkenexpress.kg

# ─── Telegram bot (top-up flow) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# OpenRouteService key for server-side road distance (optional)
ORS_API_KEY=
